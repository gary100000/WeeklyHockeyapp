generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerType {
  Regular
  Substitute
}

enum PlayerCountry {
  US
  CA
}

enum Position {
  Forward
  Defence
  Goalie
}

enum AvailabilityStatus {
  Waiting
  Yes
  No
  AddedAsSub
  Removed
}

enum GameStatus {
  Draft
  AvailabilityOpen
  FillingSubs
  Full
  Complete
  Cancelled
}

enum SmsDirection {
  Incoming
  Outgoing
}

model Player {
  id             Int                 @id @default(autoincrement())
  firstName      String
  lastName       String
  mobileNumber   String
  playerType     PlayerType
  position       Position
  country        PlayerCountry       @default(CA)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  availabilities GameAvailability[]
  substitute     Substitute?
  smsMessages    SmsMessage[]
}

model Substitute {
  id       Int     @id @default(autoincrement())
  playerId Int     @unique
  priority Int
  active   Boolean @default(true)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Arena {
  id      Int    @id @default(autoincrement())
  name    String
  address String

  games    Game[]
  settings TeamSettings[]
}

model TeamSettings {
  id                      Int     @id @default(1)
  teamName                String
  defaultGameDay          String
  defaultGameTime         String
  maximumPlayers          Int
  goalieRequirement       Int
  defenceRequirement      Int     @default(0)
  forwardRequirement      Int     @default(0)
  defenceDeclineThreshold Int     @default(2)
  defenceMaxWithSubs      Int     @default(8)
  forwardDeclineThreshold Int     @default(4)
  forwardMaxWithSubs      Int     @default(14)
  responseDeadlineHours   Int     @default(24)
  reminderHours           Int     @default(48)
  finalDeadlineTreatNo    Boolean @default(false)
  adminName               String
  adminMobileNumber       String

  arenaId Int?
  arena   Arena? @relation(fields: [arenaId], references: [id])
}

model Game {
  id                      Int        @id @default(autoincrement())
  gameDate                DateTime
  gameTime                String
  arenaId                 Int
  maximumPlayers          Int
  goalieRequirement       Int
  defenceRequirement      Int        @default(0)
  forwardRequirement      Int        @default(0)
  defenceDeclineThreshold Int        @default(2)
  defenceMaxWithSubs      Int        @default(8)
  forwardDeclineThreshold Int        @default(4)
  forwardMaxWithSubs      Int        @default(14)
  responseDeadlineHours   Int        @default(24)
  reminderHours           Int        @default(48)
  finalDeadlineTreatNo    Boolean    @default(false)
  reminderSentAt          DateTime?
  status                  GameStatus @default(Draft)
  createdAt               DateTime   @default(now())

  arena          Arena              @relation(fields: [arenaId], references: [id])
  availabilities GameAvailability[]
  smsMessages    SmsMessage[]
}

model GameAvailability {
  id           Int                @id @default(autoincrement())
  gameId       Int
  playerId     Int
  playerType   PlayerType
  status       AvailabilityStatus @default(Waiting)
  responseTime DateTime?
  contactedAt  DateTime?
  smsMessageId String?

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
}

model SmsMessage {
  id         Int          @id @default(autoincrement())
  playerId   Int?
  gameId     Int?
  direction  SmsDirection
  message    String
  providerId String?
  status     String?
  createdAt  DateTime     @default(now())

  player Player? @relation(fields: [playerId], references: [id])
  game   Game?   @relation(fields: [gameId], references: [id])
}